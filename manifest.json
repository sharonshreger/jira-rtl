{
  "manifest_version": 3,
  "name": "Jira RTL",
  "version": "0.2.0",
  "description": "Automatic RTL/LTR support for Hebrew and Arabic content in Jira.",
  "content_scripts": [
    {
      "matches": ["https://*.atlassian.net/*", "https://*/jira/*", "https://*/browse/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
