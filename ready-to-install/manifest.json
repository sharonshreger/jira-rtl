{
  "name": "Jira RTL",
  "description": "Automatically aligns RTL text in Atlassian Jira.",
  "version": "1.0.3",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.atlassian.net/*",
        "https://*.jira.com/*",
        "https://issues.devops.poalim.bank/*"
      ],
      "js": [
        "assets/browser-polyfill.min.js",
        "assets/jira-rtl.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://*.atlassian.net/*",
        "https://*.jira.com/*",
        "https://issues.devops.poalim.bank/*"
      ],
      "resources": [
        "assets/jira-rtl.css"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "@jira-rtl.Or-Liran",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
